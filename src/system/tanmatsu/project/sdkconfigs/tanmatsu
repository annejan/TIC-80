CONFIG_IDF_TARGET="esp32p4"
CONFIG_BSP_TARGET_TANMATSU=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition_tables/esp32p4-16mb.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_LCD_DSI_ISR_IRAM_SAFE=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FATFS_VOLUME_COUNT=3
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=8192
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=64
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=n
CONFIG_SPI_FLASH_SUPPORT_WINBOND_CHIP=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_BOOTLOADER_REGION_PROTECTION_ENABLE=n
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESP32P4_REV_MIN_FULL=1
CONFIG_ESP_REV_MIN_FULL=1

# TIC-80 uses neither radio, and leaving them out keeps internal RAM free
# for the drivers and the emulator.
CONFIG_BT_ENABLED=n
# TIC-80's static buffers do not fit in internal RAM; see linker.lf.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Performance. TIC-80's working set lives in PSRAM, so cache size and clock
# both matter more here than they would for a typical badge app.
# Dynamic frequency scaling is off on purpose: it clocks down under exactly the
# load we care about. Costs battery life.
CONFIG_PM_ENABLE=n
# 400 MHz is rejected on pre-v3 P4 silicon ("invalid CPU frequency value" from
# esp_clk_init), and this board selects REV_LESS_V3, so 360 MHz is the ceiling.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
# 256 KiB of L2, up from the 128 KiB default. The cache is carved out of the
# same internal RAM the heap uses, so 512 KiB would leave too little; 256 KiB
# is enough for a column-wise walk of TIC-80's 147 KiB screen buffer, which is
# what the display rotation does every frame.
CONFIG_CACHE_L2_CACHE_256KB=y
# Handing out internal RAM first was measured and made things worse: with a
# 128 KiB threshold fire.tic went from 43.1 ms to 47.3 ms a frame. Cached PSRAM
# is doing better here than a scramble for the small internal pool, so the
# threshold stays where the default put it.
